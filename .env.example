# Copy this file to .env and fill in real values. Never commit .env.

APP_ENV=production

# Where contact form submissions get emailed to.
ADMIN_EMAIL=you@example.com

# SMTP (Gmail app password or any SMTP-compatible provider).
# Leave SMTP_USER/SMTP_PASS blank to disable email sending — the form will
# still validate correctly, it just won't actually send anything, which is
# fine for testing locally.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="BROX Tech"

# Shown in the footer / contact page.
SITE_CONTACT_EMAIL=hello@broxpvt.com
SITE_CONTACT_PHONE=+966 5X XXX XXXX
SITE_LOCATION=Jeddah, Saudi Arabia
